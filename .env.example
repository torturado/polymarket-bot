POLYMARKET_HOST=https://clob.polymarket.com
CHAIN_ID=137
PRIVATE_KEY=
FUNDER=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Optional WS
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
USE_WEBSOCKET=false
# JSON object. Example:
# POLYMARKET_WS_HEADERS={"User-Agent":"Mozilla/5.0","Origin":"https://polymarket.com"}
POLYMARKET_WS_HEADERS=
# JSON object. Example:
# POLYMARKET_WS_COOKIES={"polymarketnonce":"...","AMP_...":"..."}
POLYMARKET_WS_COOKIES=
# Si lo dejas vacío, el bot auto-suscribe a todos los YES/NO de MARKET_SPECS.
POLYMARKET_WS_SUBSCRIBE_MESSAGE=
POLYMARKET_WS_HEARTBEAT_INTERVAL_S=15

# Markets
# JSON list with condition_id, yes_token_id, no_token_id
MARKET_SPECS=[]
# Alternativa: archivo JSON con la misma lista (puedes actualizarlo cada 15m)
MARKET_SPECS_FILE=
MARKET_REFRESH_INTERVAL_S=0

# Auto-update script (update_market_specs.py)
# Regex para filtrar (ticker/slug/título), ej: "(?i)xrp-updown-15m-\\d+"
MARKET_FILTER_REGEX=
# gamma_15m | simplified | sampling_simplified | markets
MARKET_SOURCE=gamma_15m
MARKET_MAX_PAGES=5
MARKET_LIMIT=10
MARKET_UPDATE_INTERVAL_S=900
MARKET_FILTER_CURRENT_WINDOW=true
MARKET_TIMEZONE=America/New_York
MARKET_WINDOW_MINUTES=15
# Para evitar que Gamma "vaya tarde" en la frontera de la ventana.
# (Se suma al instante de window_end al alinear el scheduler.)
MARKET_WINDOW_GRACE_S=2

# Gamma API (usado cuando MARKET_SOURCE=gamma_15m)
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
GAMMA_TAG_SLUG=15M
GAMMA_LIMIT=100
GAMMA_OFFSET=0
GAMMA_ORDER=volume24hr
GAMMA_ASCENDING=false
GAMMA_ACTIVE=true
GAMMA_ARCHIVED=false
GAMMA_CLOSED=false

# Trading parameters
ENTRY_THRESHOLD=0.15
TARGET_PROFIT_THRESHOLD=0.98
STOP_LOSS_THRESHOLD=1.05
# USDC budget por patita (size = budget / price)
MAX_POSITION_SIZE=100.0
# Por defecto, entra con el 100% del presupuesto. Baja esto (ej 0.5)
# si quieres dejar margen para SCALEIN.
INITIAL_ENTRY_FRACTION=1.0
MIN_MARKET_VOLATILITY=0.05
# Si cualquiera de las asks supera este nivel, no entra.
# Alias: NO_ENTRY_IF_EITHER_ASK_ABOVE (si MAX_OPPOSITE_ASK_FOR_ENTRY está vacío)
MAX_OPPOSITE_ASK_FOR_ENTRY=0.95
# Alias para MAX_OPPOSITE_ASK_FOR_ENTRY (no pongas ambos)
NO_ENTRY_IF_EITHER_ASK_ABOVE=
# CRÍTICO: no entres si (leg1_ask + opp_ask) supera esto.
# Valores típicos: 1.00–1.01 (ej. 1.005).
MAX_ENTRY_EXIT_COST=1.005
# Exige que la contraparte esté "cara" (asimetría real)
MIN_OPPOSITE_ASK=0.0
# Profundidad mínima (USDC) en top-N asks para YES y NO (requiere WS book snapshots)
MIN_BOOK_DEPTH_USDC=0.0
# Edge mínima en bps: (1 - (entry_ask + opp_ask)) * 10000
MIN_SPREAD_BASIS_POINTS=0
# Protección: si el spread (ask - bid) de la pata a entrar supera esto, no entra.
MAX_ENTRY_SIDE_SPREAD=0.03
# N niveles para el cálculo de profundidad
BOOK_DEPTH_LEVELS=5

# Timing: activa entradas sólo si faltan <= N segundos para el fin de la ventana (0 = desactivado)
ENTRY_ACTIVE_LAST_S=0

# Burst execution (order-splitting) - para imitar “ráfagas” de fills
USE_BURST_EXECUTION=false
# Unidad del slice: shares | usdc
BURST_CHUNK_UNIT=shares
# Tamaño de cada fragmento (shares)
BURST_MIN_CHUNK_SHARES=20
BURST_MAX_CHUNK_SHARES=50
# Tamaño de cada fragmento (USDC) si BURST_CHUNK_UNIT=usdc
BURST_MIN_CHUNK_USDC=20
BURST_MAX_CHUNK_USDC=50
# Número máximo de órdenes por ráfaga
BURST_MAX_ORDERS=25
# Sleep aleatorio entre órdenes (ms)
BURST_MIN_DELAY_MS=0
BURST_MAX_DELAY_MS=50
# FOK | FAK | GTC | GTD (recomendado: FOK o FAK)
BURST_ORDER_TYPE=FOK
# Si true, usa endpoint batch (post_orders) en grupos de BURST_BATCH_SIZE
BURST_USE_BATCH_ENDPOINT=false
BURST_BATCH_SIZE=10
# Slippage absoluto permitido vs el precio “de referencia” (ej 0.01 = 1 centavo)
BURST_MAX_PRICE_SLIPPAGE=0.0
# Si true: corta la ráfaga si cambia el best_ask vs reference_price
BURST_STOP_ON_PRICE_CHANGE=false
# Tolerancia absoluta para detectar cambio de precio (0 = cualquier cambio)
BURST_PRICE_CHANGE_TOLERANCE=0.0
# Si true y hay snapshot L2: limita el slice por best_ask_size (shares)
BURST_USE_BEST_ASK_SIZE=true
# Paper: loggea cada slice como fila LEG1_SLICE/LEG2_SLICE
BURST_LOG_SLICES_IN_PAPER=false
# Paper: consume best_ask_size localmente durante la ráfaga
BURST_CONSUME_BOOK_IN_PAPER=true
# Paper: intenta simular FOK vs profundidad (requiere L2)
BURST_SIMULATE_FOK_BY_DEPTH=false
# Scale-in opcional: sube el chunk si el precio cae
BURST_SCALEIN_ON_PRICE_DROP=false
BURST_SCALEIN_MULTIPLIER=1.5

# Scale-in limitado (averaging, 1–2 recargas como en fingerprints)
SCALEIN_ENABLED=false
SCALEIN_MAX_ADDS=2
SCALEIN_ADD_USDC=20.0
SCALEIN_TRIGGER_DROP_ABS=0.01
SCALEIN_MIN_INTERVAL_S=1.0

# Churning: toma profit vendiendo (SELL) si el bid sube lo suficiente
CHURN_ENABLED=false
CHURN_TAKE_PROFIT_ABS=0.01

# Synthetic arbitrage: compra YES+NO si (ask_yes + ask_no) es barato
ARB_ENABLED=false
ARB_MAX_ENTRY_EXIT_COST=0.99
# Presupuesto total USDC para ambas patas (shares = budget / (ask_yes + ask_no))
ARB_BUDGET_USDC=100.0

# Vacuum bids (liquidez pasiva barata en 0.01–0.05)
VACUUM_ENABLED=false
# JSON list o lista separada por comas, ej: [0.01,0.02,0.03,0.04]  o  0.01,0.02,0.03,0.04
VACUUM_PRICES=[0.01,0.02,0.03,0.04]
VACUUM_USDC_PER_ORDER=10.0
VACUUM_ORDER_TYPE=GTC

# Optional: EMA crash filter (entry only if price dips vs EMA)
USE_EMA_CRASH_FILTER=false
EMA_ALPHA=0.2
EMA_CRASH_RATIO=0.9
EMA_MIN_SAMPLES=10

# Risk
MAX_CONCURRENT_POSITIONS=5
MAX_DAILY_LOSS=500.0
MAX_ENTRIES_PER_CONDITION=1
REENTRY_COOLDOWN_S=60
# Alias para REENTRY_COOLDOWN_S
PER_CONDITION_LOCK_SECONDS=
ENTRY_SIGNAL_MIN_INTERVAL_MS=250
# Alias para ENTRY_SIGNAL_MIN_INTERVAL_MS
SIGNAL_COOLDOWN_MS=

# Paper trading
PAPER_TRADING=true
PAPER_TRADES_LOG=paper_trades.csv
# Saldo inicial simulado (USDC) para la billetera virtual de paper trading
PAPER_INITIAL_BALANCE=100.0

# Monitoring
POLLING_INTERVAL_MS=250

# Logging
LOG_LEVEL=INFO

# Dashboard (web UI)
# Ejecuta: venv/bin/python src/dashboard.py  y abre http://127.0.0.1:8000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_SNAPSHOT_INTERVAL_S=1.0
DASHBOARD_MAX_EVENTS=500
