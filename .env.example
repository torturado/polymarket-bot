# Polymarket API Credentials
# Copy this file to .env and fill in your actual credentials
# The .env file is ignored by git for security

# Option 1: Bearer Token (if Polymarket uses bearer token authentication)
POLYMARKET_BEARER_TOKEN=your_bearer_token_here

# Option 2: API Key/Secret (if Polymarket uses API key authentication)
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here

# Note: Only set the credentials that Polymarket's API requires
# For read-only market data, credentials may not be necessary
